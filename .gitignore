# wrangler 빌드 캐시 (배포 부산물 — 추적 금지)
.wrangler/
**/.wrangler/

# wrangler deploy 빌드 산출(번들 — 추적 금지, deploy 시 재생성)
dist/
**/dist/

# node 의존성
node_modules/
**/node_modules/

# python 가상환경 (테스트/설치 부산물 — 추적 금지)
.venv/
.venv*/
**/.venv/
venv/
*venv*/
**/*venv*/

# python 컴파일 캐시
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# secrets / credentials
.env
*.env
*_secret*
*_token*
credentials*
private_key*
*.pem
*.key

# 실 데이터 / 운영 저장소
*.sqlite
*.db
localcrab_index.sqlite
*_graph.yaml
localbinggu_production_graph.yaml
reingest_pack_draft/
reports/
reviews/
captures/
packs/private/
hosted/workers/data/

# 빌드/임시
tmp/
__pycache__/
*.bak_*
*.zip

# 로컬 키 사본 — 절대 커밋 금지
.dev.vars*

# watcher selftest 합성 PII fixture (가짜 AWS예시키·가짜 주민/전화 — ensure_fixtures가 런타임 생성)
tests/fixtures/watcher_m1_batch/
