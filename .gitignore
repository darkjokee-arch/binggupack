# wrangler 빌드 캐시 (배포 부산물 — 추적 금지)
.wrangler/
**/.wrangler/

# wrangler deploy 빌드 산출(번들 — 추적 금지, deploy 시 재생성)
dist/
**/dist/

# S2-6 parity 하네스 컴파일 산출물 (npm run test:parity 가 매번 재생성)
dist-parity/
**/dist-parity/

# node 의존성
node_modules/
**/node_modules/

# python 가상환경 (테스트/설치 부산물 — 추적 금지)
.venv/
.venv*/
**/.venv/
venv/
*venv*/
**/*venv*/

# python 컴파일 캐시
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# python 빌드/패키징 산출물 (pip install/-m build 부산물 — 추적 금지, PII tree-scan 제외와 정합)
build/
**/build/
*.egg-info/
**/*.egg-info/

# secrets / credentials
.env
*.env
*_secret*
*_token*
credentials*
private_key*
*.pem
*.key

# 실 데이터 / 운영 저장소
*.sqlite
*.db
localcrab_index.sqlite
*_graph.yaml
localbinggu_production_graph.yaml
reingest_pack_draft/
reports/
reviews/
captures/
packs/private/
hosted/workers/data/

# 빌드/임시
tmp/
__pycache__/
*.bak_*
*.zip

# 로컬 백업 폴더 (휴면 구버전 사본 — 추적/패키징/import 금지, 삭제하지 말고 격리만)
_backup/
**/_backup/

# BINGGU_HOME 격리 테스트/평가 홈 (last_preview_candidates.json 뿐, ledger 없음 — 추적 금지)
_*_home/

# 런타임 로그 (추적 금지)
logs/

# 로컬 키 사본 — 절대 커밋 금지
.dev.vars*

# watcher selftest 합성 PII fixture (가짜 AWS예시키·가짜 주민/전화 — ensure_fixtures가 런타임 생성)
tests/fixtures/watcher_m1_batch/
